{
  "name": "bytely",
  "version": "0.3.1",
  "type": "module",
  "description": "Easily parse binary data into JavaScript Objects",
  "typings": "dist/index.d.ts",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite --port 8080",
    "build": "tsc && vite build",
    "build:types": "tsc -d --declarationDir dist --declarationMap --emitDeclarationOnly",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/max-bronner/bytely",
  "repository": {
    "url": "https://github.com/max-bronner/bytely"
  },
  "bugs": {
    "url": "https://github.com/max-bronner/bytely/issues"
  },
  "keywords": [
    "binary",
    "byte",
    "parser",
    "converter",
    "struct"
  ],
  "author": {
    "name": "Max Bronner",
    "email": "max2bronner@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^0.34.6",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^0.34.6"
  }
}
